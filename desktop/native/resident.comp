#version 450
#extension GL_GOOGLE_include_directive : require
#include "terni/compute.glsl"
#include "timer.glsl"

layout(constant_id = 2) const uint gateCount = 0;
layout(constant_id = 3) const uint stateCount = 0;

layout(constant_id = 5) const uint extended = 0;
layout(constant_id = 6) const uint inputCount = 0;
layout(constant_id = 7) const uint busCount = 0;
layout(constant_id = 8) const uint programmerCount = 0;
layout(std430, binding = 0) readonly buffer GateRows { int gates[]; };
layout(std430, binding = 1) readonly buffer InputPins { int pins[]; };
layout(std430, binding = 2) readonly buffer Destinations { int writes[]; };
layout(std430, binding = 3) readonly buffer Initial { uint initial[]; };
#include "programmer.glsl"
#ifdef HOST_EVENTS
#include "ram.glsl"
#endif
layout(std430, binding = 5) buffer Signals { uint current[]; };
layout(std430, binding = 6) buffer DriverFlags { uint flags[]; };

uint level(int index) {
    return index < 0 ? 0u : (extended != 0 ? current[index] & 1u : current[index]);
}

#if !defined(INITIALIZE) && !defined(COMMIT)
bool readPin(int row) {
    uint index = uint(row) * 4;
    uint signal = level(pins[index]) | level(pins[index + 1]) |
                  level(pins[index + 2]) | level(pins[index + 3]);
    bool high = (signal ^ initial[stateCount + uint(row)]) != 0;
    atomicOr(flags[writes[gateCount * 5 + uint(row)]], 2u | uint(high));
    return high;
}

bool readAny(uint base, uint first, uint end) {
    for (uint pin = first; pin < end; ++pin) {
        int row = gates[base + 1 + pin];
        if (row < 0) break;
        if (readPin(row)) return true;
    }
    return false;
}
#endif

void main() {
#if defined(INITIALIZE)
    FOR_EACH(i, stateCount) {
        uint value = initial[i];
        if ((busCount != 0 || programmerCount != 0) && i >= stateCount - programmerCount - busCount) {
            current[i] = value;
            flags[i] = 0;
            continue;
        }
        current[i] = (value & 1u) | (extended != 0 ? (value >> 3) << 1 : 0u);
        uint pending = (value >> 1) & 1u;
        // Bits 2 and 3 mark the host's pending value. Bits 5 and above carry private runtime state.
        flags[i] = 4u | (pending << 3) | ((value & 4u) != 0 ? 2u | pending : 0u);
    }
#elif defined(COMMIT)
    FOR_EACH(i, stateCount) {
        if (programmerCount != 0 && i >= stateCount - programmerCount) continue;
        uint written = flags[i];
        if (busCount != 0 && i >= stateCount - programmerCount - busCount)
            current[i] = (current[i] & ~(written & 255u)) | (written >> 8);
        else if ((written & 2u) != 0) current[i] = (written & 1u) | (extended != 0 ? (written >> 5) << 1 : 0u);
        else if ((written & 4u) != 0) current[i] = written >> 3;
        flags[i] = 0;
    }
#else
    FOR_EACH(row, gateCount) {
        uint base = row * 5;
        int op = gates[base];
        uint driven;
        bool carry = gates[base + 1] >= 0;
        if (extended != 0 && (op == 19 || op == 20)) {
            uint extra = gateCount * 5 + inputCount + base;
            int bus = writes[extra];
            uint mask = 1u << initial[stateCount + inputCount + row * 3];
            if (op == 19) {
                if (bus >= 0) {
                    uint high = level(writes[extra + 1]) | level(writes[extra + 2]) |
                                level(writes[extra + 3]) | level(writes[extra + 4]);
                    atomicOr(flags[bus], mask | (high != 0 ? mask << 8 : 0u));
                }
                continue;
            }
            driven = 2u | uint(bus >= 0 && (current[bus] & mask) != 0);
        } else if (extended != 0 && op >= 7) {
            int self = writes[base];
            uint state = current[self];
            uint pending = flags[self];
            bool value = ((pending & 4u) != 0 ? pending & 8u : state & 1u) != 0;
            uint next;
            if (op == 32) {
                bool locked = readAny(base, 0, 4);
                next = locked ? 2u : uint(value);
            } else
#ifdef HOST_EVENTS
            if (op == 33) {
                uint param = stateCount + inputCount + row * 3;
                next = uint(stepSerial(initial[param], readAny(base, 0, 4)));
            } else if (op == 31) {
                bool high = readAny(base, 0, 4);
                uint param = stateCount + inputCount + row * 3;
                next = stepStop(high, state, value, initial[param] != 0);
            } else if (op >= 26) {
                uint controllerCount = uint(op - 26);
                bool control = readAny(base, 0, controllerCount);
                bool high = readAny(base, controllerCount, 4);
                uint param = stateCount + inputCount + row * 3;
                next = uint(stepRam(initial[param], control, high, value));
            } else
#endif
            if (op >= 21 && op < 26) {
                uint param = stateCount + inputCount + row * 3;
                uint controllerCount = uint(op - 21);
                bool reset = readAny(base, 0, controllerCount);
                bool clock = readAny(base, controllerCount, 4);
                uint slot = initial[param + 2];
                int index = int(current[slot]);
                uint byteCount = initial[param + 1];
                next = stepProgrammer(reset, clock, state, value, initial[param], byteCount, index);
                current[slot] = uint(index);
                carry = index >= int(byteCount * 8u) - 1;
            } else if (op >= 17) {
                bool high = readAny(base, 0, 4);
                uint param = stateCount + inputCount + row * 3;
                next = tickTimer(op, high, state, value, int(initial[param]), int(initial[param + 1]));
            } else {
                bool toggle = op >= 12;
                uint controllerCount = uint(op - (toggle ? 12 : 7));
                bool data = toggle && readAny(base, controllerCount, 4);
                bool control = readAny(base, 0, controllerCount);
                bool armed = (state & 2u) != 0;
                if (toggle) {
                    if (control) value = false;
                    else if (data && armed) value = (state & 1u) == 0;
                } else if (control && armed) {
                    value = readAny(base, controllerCount, 4);
                }
                next = (uint(!(toggle ? data : control)) << 1) | uint(value);
            }
            driven = 2u | (next & 1u);
            atomicOr(flags[self], driven | ((next >> 1) << 5));
        } else {
            bool all = op < 2;
            bool parity = op >= 4;
            bool value = all && gates[base + 1] >= 0;
            for (uint pin = 0; pin < 4; ++pin) {
                int inputRow = gates[base + 1 + pin];
                if (inputRow < 0 || (!parity && value != all)) break;
                bool high = readPin(inputRow);
                if (extended != 0 && op == 6) carry = carry && high;
                value = parity ? value != high : high;
            }
            driven = 2u | uint(value != ((op & 1) != 0));
            atomicOr(flags[writes[base]], driven);
        }
        if (extended != 0 && (op == 6 || (op >= 21 && op < 26))) {
            uint extra = inputCount + gateCount * 5 + base;
            for (uint pin = 0; pin <= 4; ++pin) {
                int sink = writes[extra + pin];
                if (sink >= 0) atomicOr(flags[sink], 2u | uint(carry));
            }
        }
        for (uint pin = 1; pin <= 4; ++pin) {
            int sink = writes[base + pin];
            if (sink >= 0) atomicOr(flags[sink], driven);
        }
    }
#endif
}
